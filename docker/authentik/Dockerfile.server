FROM ghcr.io/goauthentik/server:2024.12

# Custom branding assets
COPY docker/authentik/custom.css /web/dist/custom.css
COPY docker/authentik/logo.svg /web/dist/assets/icons/ghostfolio-logo.svg
COPY docker/authentik/flow_background.jpg /web/dist/assets/images/flow_background.jpg

# Startup wrapper that applies branding on every boot
COPY docker/authentik/start-server.sh /scripts/start-server.sh
RUN chmod +x /scripts/start-server.sh

CMD ["/scripts/start-server.sh"]
